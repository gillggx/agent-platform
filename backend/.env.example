# =============================================================================
# Agent Platform — Backend Environment Configuration
#
# 第一次用？先看 deploy/QUICKSTART.md
# 複製這個檔到 .env：
#   cp .env.example .env
# 然後編輯 .env，只要改 LLM_API_KEY 和 SECRET_KEY 兩個值，其他照抄。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM Configuration (必填)
# -----------------------------------------------------------------------------

# 你的 OpenRouter / OpenAI / Anthropic 金鑰
# OpenRouter 申請: https://openrouter.ai/settings/keys
# 金鑰看起來像: sk-or-v1-abc123... (60 個字元左右)
# ⚠️ 絕對不要 commit 到 git
LLM_API_KEY=

# LLM 供應商 (openrouter 能一個 key 用 100+ 種 model，推薦)
LLM_PROVIDER=openrouter

# 預設 model。要換別的 model 只改這一行，重啟 backend 即生效。
# 常用選項:
#   openrouter/openai/gpt-oss-120b          - 快、免費額度較不易被擠爆（預設）
#   openrouter/google/gemini-2.0-flash-001  - 非常便宜但共用池常被 rate limit
#   openrouter/anthropic/claude-sonnet-4-5  - 最聰明，付費額度較高
LLM_MODEL=openrouter/openai/gpt-oss-120b

# OpenRouter 的 API 位置。用自架 proxy / gateway 再改這個，否則保留預設。
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# 2. Database (預設用 SQLite，一般不用動)
# -----------------------------------------------------------------------------

# 預設 SQLite — 檔案會放在 backend/data/app.db，零設定。
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 如果要換成 PostgreSQL (高併發場景):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_platform

# -----------------------------------------------------------------------------
# 3. Security (必填)
# -----------------------------------------------------------------------------

# 伺服器內部加密金鑰。你不會直接用到，但每個環境要不同。
# 產一個新的，跑：
#     openssl rand -hex 32
# 貼上去（64 個十六進位字元）。
SECRET_KEY=dev-secret-key-change-in-production

# -----------------------------------------------------------------------------
# 4. External Services (選填)
# -----------------------------------------------------------------------------

# Code Architect Agent 服務（如果你有架 https://github.com/gillggx/code-architect）
# 用於專案 codebase 分析和 A2A 工具。沒架不用填。
# CODE_ARCHITECT_URL=http://localhost:8001
